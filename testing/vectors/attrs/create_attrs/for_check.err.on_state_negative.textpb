# proto-file: testing/vectors/attrs/create_attrs/test_case.proto
# proto-message: CreateAttrs
#
# `CheckAttribute` rejects a negative number as `on_state`, and the error shows
# the rejected value.

input {
  for_check {
    name: "my_team.metric"
    expression: "true"
    on_state: -1
  }
}
err: "invalid check state: -1"
