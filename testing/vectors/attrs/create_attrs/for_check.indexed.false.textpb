# proto-file: testing/vectors/attrs/create_attrs/test_case.proto
# proto-message: CreateAttrs
#
# `CheckAttribute` sets `indexed` to false when false is passed (instead of
# leaving it unset).

input {
  for_check {
    name: "my_team.metric"
    expression: "true"
    indexed: false
  }
}
output {
  check_attribute {
    name: "my_team.metric"
    expression: "true"
    indexed: false
  }
}
