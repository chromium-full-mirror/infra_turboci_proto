# proto-file: testing/vectors/attrs/create_attrs/test_case.proto
# proto-message: CreateAttrs
#
# `StageAttribute` rejects a name with a `$`, and the error names it and
# explains the expected format.

input {
  for_stage {
    name: "foo.bar$"
    expression: "true"
  }
}
err: "invalid attribute name \"foo.bar$\": expected dot-separated lower_snake_case with at least one dot (e.g. 'namespace.my_attr')"
