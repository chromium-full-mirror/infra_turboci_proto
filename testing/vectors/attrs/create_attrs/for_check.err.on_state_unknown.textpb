# proto-file: testing/vectors/attrs/create_attrs/test_case.proto
# proto-message: CreateAttrs
#
# `CheckAttribute` rejects `CHECK_STATE_UNKNOWN` as `on_state`, and the error
# shows the rejected value.

input {
  for_check {
    name: "my_team.metric"
    expression: "true"
    on_state: CHECK_STATE_UNKNOWN
  }
}
err: "invalid check state: CHECK_STATE_UNKNOWN"
