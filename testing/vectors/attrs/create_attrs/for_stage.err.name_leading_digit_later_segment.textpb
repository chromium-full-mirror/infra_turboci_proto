# proto-file: testing/vectors/attrs/create_attrs/test_case.proto
# proto-message: CreateAttrs
#
# `StageAttribute` rejects a name whose later segment starts with a digit, and
# the error names it and explains the expected format.

input {
  for_stage {
    name: "foo.1bar"
    expression: "true"
  }
}
err: "invalid attribute name \"foo.1bar\": expected dot-separated lower_snake_case with at least one dot (e.g. 'namespace.my_attr')"
