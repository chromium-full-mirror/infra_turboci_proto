# proto-file: testing/vectors/attrs/create_attrs/test_case.proto
# proto-message: CreateAttrs
#
# `StageAttribute` rejects a negative number as `attribute_type`, and the error
# shows the rejected value.

input {
  for_stage {
    name: "my_team.metric"
    expression: "true"
    attribute_type: -1
  }
}
err: "invalid attribute type: -1"
