# proto-file: testing/vectors/attrs/create_attrs/test_case.proto
# proto-message: CreateAttrs
#
# `StageAttribute` copies the passed `on_state`, `attribute_type`, and `indexed`
# into the returned write.

input {
  for_stage {
    name: "my_team.metric"
    expression: "true"
    on_state: STAGE_STATE_FINAL
    attribute_type: ATTRIBUTE_TYPE_INT64
    indexed: true
  }
}
output {
  stage_attribute {
    name: "my_team.metric"
    expression: "true"
    on_state: STAGE_STATE_FINAL
    attribute_type: ATTRIBUTE_TYPE_INT64
    indexed: true
  }
}
