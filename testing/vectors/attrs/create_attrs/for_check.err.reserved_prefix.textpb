# proto-file: testing/vectors/attrs/create_attrs/test_case.proto
# proto-message: CreateAttrs
#
# `CheckAttribute` rejects a name with a reserved prefix, and the error names it
# and the prefix.

input {
  for_check {
    name: "check.metric"
    expression: "true"
  }
}
err: "invalid attribute name \"check.metric\": uses reserved prefix \"check.\""
