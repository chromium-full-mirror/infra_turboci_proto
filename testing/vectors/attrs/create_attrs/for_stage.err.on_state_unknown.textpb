# proto-file: testing/vectors/attrs/create_attrs/test_case.proto
# proto-message: CreateAttrs
#
# `StageAttribute` rejects `STAGE_STATE_UNKNOWN` as `on_state`, and the error
# shows the rejected value.

input {
  for_stage {
    name: "my_team.metric"
    expression: "true"
    on_state: STAGE_STATE_UNKNOWN
  }
}
err: "invalid stage state: STAGE_STATE_UNKNOWN"
