# proto-file: testing/vectors/attrs/create_attrs/test_case.proto
# proto-message: CreateAttrs
#
# `AddCheckAttributes` rejects a call that passes two attributes with the same
# name, and the error names the duplicate.

input {
  add_check_attributes {
    check_write {}
    attributes {
      name: "my_team.dup"
      expression: "true"
    }
    attributes {
      name: "my_team.dup"
      expression: "false"
    }
  }
}
err: "duplicate attribute name \"my_team.dup\""
