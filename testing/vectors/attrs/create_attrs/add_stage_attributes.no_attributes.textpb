# proto-file: testing/vectors/attrs/create_attrs/test_case.proto
# proto-message: CreateAttrs
#
# `AddStageAttributes` called without attributes leaves the `StageWrite`
# unchanged.

input {
  add_stage_attributes {
    stage_write {
      attributes {
        name: "my_team.attr1"
        expression: "true"
        on_state: STAGE_STATE_FINAL
        attribute_type: ATTRIBUTE_TYPE_BOOL
        indexed: true
      }
    }
  }
}
output {
  stage_write {
    attributes {
      name: "my_team.attr1"
      expression: "true"
      on_state: STAGE_STATE_FINAL
      attribute_type: ATTRIBUTE_TYPE_BOOL
      indexed: true
    }
  }
}
