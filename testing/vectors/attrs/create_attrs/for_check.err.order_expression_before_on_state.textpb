# proto-file: testing/vectors/attrs/create_attrs/test_case.proto
# proto-message: CreateAttrs
#
# `CheckAttribute` checks the expression before `on_state`: with both invalid,
# the error is about the expression.

input {
  for_check {
    name: "my_team.metric"
    expression: ""
    on_state: CHECK_STATE_UNKNOWN
  }
}
err: "expression cannot be empty"
