# proto-file: testing/vectors/attrs/create_attrs/test_case.proto
# proto-message: CreateAttrs
#
# `StageAttribute` rejects names starting with `workplan.`, and the error names
# the attribute and the prefix.

input {
  for_stage {
    name: "workplan.my_attr"
    expression: "true"
  }
}
err: "invalid attribute name \"workplan.my_attr\": uses reserved prefix \"workplan.\""
