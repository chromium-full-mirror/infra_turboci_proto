# proto-file: testing/vectors/attrs/create_attrs/test_case.proto
# proto-message: CreateAttrs
#
# `StageAttribute` rejects a name with two dots in a row, and the error names it
# and explains the expected format.

input {
  for_stage {
    name: "team..metric"
    expression: "true"
  }
}
err: "invalid attribute name \"team..metric\": expected dot-separated lower_snake_case with at least one dot (e.g. 'namespace.my_attr')"
