# proto-file: testing/vectors/attrs/create_attrs/test_case.proto
# proto-message: CreateAttrs
#
# `StageAttribute` rejects names starting with `stage.`, and the error names the
# attribute and the prefix.

input {
  for_stage {
    name: "stage.my_attr"
    expression: "true"
  }
}
err: "invalid attribute name \"stage.my_attr\": uses reserved prefix \"stage.\""
